NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:8081
ACCESS_TOKEN_SECRET=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
RESET_TOKEN_TTL_MINUTES=15
BCRYPT_ROUNDS=12
AUTH_STORE_PATH=./data/auth-store.json

# Opcional: persistencia em banco gerenciado (PostgreSQL)
DATABASE_URL=
AUTH_STORE_TABLE=auth_state

# SMTP (recuperacao por email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SecPass <no-reply@secpass.app>"

# URL base do frontend/tela de reset
PASSWORD_RESET_URL_BASE=https://secpass.app/reset-password
